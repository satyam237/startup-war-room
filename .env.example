# Copy to .env (git-ignored). Never commit real values.
# LLM_PROVIDER: openrouter | fake (fake needs no key and makes no network calls)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAST_MODEL=openai/gpt-6.1-terra
AGENT_MODEL=openai/gpt-6.1-terra
JUDGE_MODEL=openai/gpt-6.1-sol
ESCALATION_MODEL=anthropic/claude-opus-5.5
FAKE_DELAY_S=0
# Heroku supplies postgres://...; it is converted to postgresql+asyncpg:// automatically.
DATABASE_URL=sqlite+aiosqlite:///./warroom.db
FRONTEND_ORIGIN=http://localhost:5173
MAX_TURNS=14
MAX_TOKENS_PER_DEBATE=120000
# Turns and checkpoints stop this far below the cap, so the judge can run. Must be below the cap.
JUDGE_TOKEN_RESERVE=60000
RATE_LIMIT_PER_HOUR=5
INTAKE_RATE_LIMIT_PER_HOUR=20
FEEDBACK_RATE_LIMIT_PER_HOUR=20
TRUSTED_PROXY_HOPS=0
REBUTTAL_TIMEOUT_S=45
DEBATE_TIMEOUT_S=240
MAX_CONCURRENT_DEBATES=10
# Proxies in front of the app whose X-Forwarded-For hop is trusted. 0 locally, 1 on Heroku.
TRUSTED_PROXY_HOPS=0

# Frontend build-time (set in Vercel, not here): VITE_API_URL=https://<your-heroku-app>.herokuapp.com

# Local deployment note only. The backend never reads this; the Heroku CLI does.
# HEROKU_API_KEY=
