LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAST_MODEL=openai/gpt-6.1-terra
AGENT_MODEL=openai/gpt-6.1-terra
JUDGE_MODEL=openai/gpt-6.1-sol
ESCALATION_MODEL=anthropic/claude-opus-5.5
DATABASE_URL=sqlite+aiosqlite:///./warroom.db
FRONTEND_ORIGIN=http://localhost:5173
MAX_TURNS=14
MAX_TOKENS_PER_DEBATE=40000
RATE_LIMIT_PER_HOUR=5
REBUTTAL_TIMEOUT_S=45
DEBATE_TIMEOUT_S=240
MAX_CONCURRENT_DEBATES=10
